---
interface Props {
	title: string;
	body: string[];
	linkLabel?: string;
	linkHref?: string;
	strongLine?: string;
}

const { title, body, linkLabel, linkHref, strongLine } = Astro.props;
---

<div class="section-intro">
	<h2>{title}</h2>
	<div class="section-intro__copy">
		{
			body.map((paragraph) => (
				<p>{paragraph}</p>
			))
		}
		{strongLine && <p class="section-intro__strong">{strongLine}</p>}
		{
			linkLabel && linkHref && (
				<a class="text-link" href={linkHref} target="_blank" rel="noreferrer">
					{linkLabel}
				</a>
			)
		}
	</div>
</div>
