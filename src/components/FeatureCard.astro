---
interface Props {
	title: string;
	description: string;
	icon: string;
}

const { title, description, icon } = Astro.props;
---

<article class="feature-card">
	<div class={`feature-card__icon feature-card__icon--${icon}`} aria-hidden="true"></div>
	<h3>{title}</h3>
	<p>{description}</p>
</article>
