---
interface Props {
	items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<header class="site-header">
	<div class="container site-header__inner">
		<div class="brand-lockup">
			<a class="brand" href="https://hypeberries.com/" aria-label="Hypeberries home">
				<img src="/images/logo.png?v=20260915" alt="" width="208" height="52" loading="eager" decoding="async" fetchpriority="high" />
			</a>
			<span class="brand-lockup__separator" aria-hidden="true">/</span>
			<a class="brand-lockup__product" href="/">Widgets</a>
		</div>
		<nav aria-label="Primary">
			<ul class="site-nav">
				{
					items.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
