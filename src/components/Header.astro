---
interface Props {
	items: Array<{ label: string; href: string }>;
}

const { items } = Astro.props;
---

<header class="site-header">
	<div class="container site-header__inner">
		<div class="brand-lockup">
			<a class="brand-lockup__product" href="https://hypeberries.com/" aria-label="Widgets, by Hypeberries">
				<img src="/widgets-wordmark.svg" alt="" width="137" height="44" loading="eager" decoding="async" fetchpriority="high" />
				<span class="brand-lockup__byline">by <strong>hypeberries</strong></span>
			</a>
		</div>
		<nav aria-label="Primary">
			<ul class="site-nav">
				{
					items.map((item) => (
						<li><a href={item.href}>{item.label}</a></li>
					))
				}
			</ul>
		</nav>
	</div>
</header>
